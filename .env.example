# Server Configuration
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pratha_ems?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="dev-jwt-access-secret-change-in-production-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-change-in-production-min-32-chars-long"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Secrets & Settings
COOKIE_SECRET="dev-cookie-secret-min-32-chars-long-secure-random"
COOKIE_SECURE="false"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
